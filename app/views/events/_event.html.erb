<% starts = event_local(event) %>
<% price = starting_price(event) %>
<li class="event-card" data-filter-target="item" data-filter-text="<%= [ event.title, event.location ].join(" ") %>">
  <%= link_to event, class: "event-card__link", aria: { label: "#{event.title}, #{l starts, format: :event_card}, #{event.location}" } do %>
    <div class="event-card__top">
      <%= date_chip(starts) %>
      <%= event_status_badge(event) if event_status(event) == :live %>
    </div>

    <h2 class="event-card__title"><%= event.title %></h2>

    <div class="event-card__meta">
      <div>
        <%= icon :clock %>
        <span><time datetime="<%= event.starts_at.iso8601 %>" class="tabular"><%= l starts, format: :event_card %></time></span>
      </div>
      <div>
        <%= icon :map_pin %>
        <span><%= event.location %></span>
      </div>
    </div>

    <div class="event-card__foot">
      <p class="event-card__price">
        <% if price.nil? %>
          <strong class="subtle">Price TBA</strong>
        <% elsif price.zero? %>
          <strong>Free</strong>
        <% else %>
          <small>From</small>
          <strong><%= format_price price, event.currency %></strong>
        <% end %>
      </p>
      <span class="event-card__arrow" aria-hidden="true"><%= icon :arrow_right %></span>
    </div>
  <% end %>
</li>
