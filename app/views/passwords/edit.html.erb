<% content_for :title, "Choose a new password · Billete" %>
<% content_for :minimal_chrome, true %>

<div class="auth">
  <div class="auth-card">
    <div class="auth-head">
      <h1>Choose a new password</h1>
      <p>You'll be signed out everywhere else once it's saved.</p>
    </div>

    <%= form_with url: password_path(params[:token]), method: :put, class: "auth-form" do |form| %>
      <div class="field">
        <%= form.label :password, "New password" %>
        <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", placeholder: "Your new password", maxlength: 72 %>
      </div>
      <div class="field">
        <%= form.label :password_confirmation, "Confirm new password" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Repeat new password", maxlength: 72 %>
      </div>
      <%= form.submit "Save new password", class: "btn btn-primary btn-lg btn-block", data: { turbo_submits_with: "Saving…" } %>
    <% end %>
  </div>
</div>
