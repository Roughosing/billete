<% content_for :title, "#{@organization.name} · Billete" %>
<% sold_share = @capacity.positive? ? (@tickets_issued * 100.0 / @capacity).round : 0 %>

<header class="page-header">
  <div class="page-header-text">
    <p class="eyebrow">Organiser dashboard</p>
    <h1><%= @organization.name %></h1>
    <p class="lede">Everything you've put on sale, at a glance. Published events are listed on the marketplace until they end.</p>
  </div>
  <div class="page-header-actions">
    <%= link_to new_organization_event_path, class: "btn btn-primary" do %>
      <%= icon :plus %> Create event
    <% end %>
  </div>
</header>

<section class="stats" aria-label="Overview">
  <div class="stat">
    <div class="stat-label"><span>Upcoming events</span><%= icon :calendar %></div>
    <div class="stat-value"><%= number_with_delimiter @upcoming_count %></div>
    <div class="stat-trend"><%= pluralize_count(@events.size, "event") %> in total</div>
  </div>
  <div class="stat">
    <div class="stat-label"><span>Tickets issued</span><%= icon :ticket %></div>
    <div class="stat-value"><%= number_with_delimiter @tickets_issued %></div>
    <div class="stat-trend">Confirmed, across all events</div>
  </div>
  <div class="stat">
    <div class="stat-label"><span>Capacity sold</span><%= icon :trending_up %></div>
    <div class="stat-value"><%= sold_share %><small>%</small></div>
    <div class="progress" role="progressbar" aria-valuenow="<%= sold_share %>" aria-valuemin="0" aria-valuemax="100" aria-label="Capacity sold">
      <span style="width: <%= sold_share %>%"></span>
    </div>
  </div>
  <div class="stat">
    <div class="stat-label"><span>Total capacity</span><%= icon :users %></div>
    <div class="stat-value"><%= number_with_delimiter @capacity %></div>
    <div class="stat-trend">Places across all ticket types</div>
  </div>
</section>

<% if @events.any? %>
  <div class="list" role="table" aria-label="Events">
    <div class="list-head" role="row">
      <span role="columnheader">Event</span>
      <span role="columnheader">Location</span>
      <span role="columnheader">Tickets</span>
      <span role="columnheader">From</span>
      <span role="columnheader" class="list-cell-end">Status</span>
    </div>
    <% @events.each do |event| %>
      <% starts = event_local(event) %>
      <% sold = @tickets_by_event.fetch(event.id, 0) %>
      <% capacity = event.ticket_types.sum(&:quantity) %>
      <% price = starting_price(event) %>
      <%= link_to event, class: "list-row", role: "row" do %>
        <div class="list-title" role="cell">
          <%= date_chip(starts) %>
          <div>
            <strong><%= event.title %></strong>
            <span class="tabular"><%= l starts, format: :event_card %></span>
          </div>
        </div>
        <span class="list-cell list-cell-hide" role="cell"><%= event.location %></span>
        <div class="list-cell list-cell-stack list-cell-hide" role="cell">
          <span class="mono small"><%= number_with_delimiter sold %> / <%= number_with_delimiter capacity %></span>
          <span class="progress" aria-hidden="true"><span style="width: <%= capacity.positive? ? (sold * 100.0 / capacity).round : 0 %>%"></span></span>
        </div>
        <span class="list-cell mono list-cell-hide" role="cell"><%= price.nil? ? "—" : format_price(price, event.currency) %></span>
        <span class="list-cell-end" role="cell"><%= event_status_badge(event) %></span>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="empty">
    <div class="empty-art"><%= icon :ticket %></div>
    <h2>No events yet</h2>
    <p>Create your first event with a date, place, and ticket types. It goes live on the marketplace straight away.</p>
    <%= link_to new_organization_event_path, class: "btn btn-primary" do %>
      <%= icon :plus %> Create your first event
    <% end %>
  </div>
<% end %>
